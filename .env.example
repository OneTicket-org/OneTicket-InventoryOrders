# Copy to .env, or export the variables in your shell.
# A variable already set in the shell takes precedence over this file.
INVENTORYORDERS_PORT=3000
# The PostgreSQL of the course stack (../course-stack)
DATABASE_URL=postgres://inventoryorders:inventoryorders-dev-secret@localhost:5433/inventoryorders
INVENTORYORDERS_PAGE_SIZE=50
INVENTORYORDERS_HOLD_TTL_SECONDS=240
INVENTORYORDERS_HOLD_MAX_PER_CUSTOMER=4
RUST_LOG=info
# Comma-separated, exact origins whose pages may call the service with credentials
INVENTORYORDERS_CORS_ORIGINS=http://localhost:5173
